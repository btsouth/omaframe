# Maintainer: btsouth (https://github.com/btsouth)
pkgname=omaframe
pkgver=@VERSION@
pkgrel=1
pkgdesc='Screenshot and screen recording studio for Omarchy and Hyprland'
arch=('x86_64')
url='https://github.com/btsouth/omaframe'
license=('MIT')
depends=('hyprland' 'qt6-base' 'qt6-declarative' 'qt6-multimedia'
         'qt6-wayland' 'layer-shell-qt' 'wayland' 'wl-clipboard' 'ffmpeg'
         'libpulse' 'procps-ng' 'xdg-utils' 'hicolor-icon-theme'
         'gpu-screen-recorder>=6.1.3')
optdepends=('libnotify: notification after a quick screenshot')
makedepends=('cmake' 'ninja' 'pkgconf' 'wayland-protocols')
options=('!debug')
source=("https://github.com/btsouth/omaframe/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

build() {
  cmake -S "${srcdir}/${pkgname}-${pkgver}" -B "${srcdir}/${pkgname}-${pkgver}/build" \
    -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "${srcdir}/${pkgname}-${pkgver}/build" -j 3
}

package() {
  DESTDIR="${pkgdir}" cmake --install "${srcdir}/${pkgname}-${pkgver}/build"
}

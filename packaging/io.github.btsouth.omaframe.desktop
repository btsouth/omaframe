[Desktop Entry]
Type=Application
Name=Omaframe
GenericName=Screenshot and screen recorder
Comment=Capture, mark up and share screenshots and screen recordings
Exec=omaframe --studio %f
Icon=omaframe
Terminal=false
Categories=Graphics;
Keywords=screenshot;screen;capture;record;recording;annotate;
MimeType=image/png;image/jpeg;image/webp;image/bmp;video/mp4;video/webm;video/x-matroska;video/quicktime;
StartupWMClass=io.github.btsouth.omaframe
Actions=Screenshot;Record;Repeat;History;

[Desktop Action Screenshot]
Name=Take a screenshot
Exec=omaframe --capture

[Desktop Action Record]
Name=Record the screen
Exec=omaframe --record

[Desktop Action Repeat]
Name=Screenshot the last area again
Exec=omaframe --repeat

[Desktop Action History]
Name=Capture history
Exec=omaframe --history
